Screen {
    layout: vertical;
    outline: round $accent;
    background: black;
}

Header {
    dock: top;
}

#main-container {
    layout: horizontal;
    height: 1fr;
}

#menu {
    width: 25%;
    height: 100%;
    background: black;
    border: solid $accent;
}

#content {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

#validation-bar {
    dock: bottom;
    height: auto;
    padding: 0 1;
}

#validate {
    width: 100%;
}

.title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    color: $accent;
}

.section-title {
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    color: $primary;
}

.description {
    color: $text;
    margin-bottom: 1;
}

.value {
    text-style: bold;
    color: $success;
}

.input-row {
    layout: horizontal;
    width: 100%;
    margin-bottom: 0;
}

.input-label {
    width: 20%;
}

.content-grid {
    layout: grid;
    width: 100%;
    margin-bottom: 1;
}